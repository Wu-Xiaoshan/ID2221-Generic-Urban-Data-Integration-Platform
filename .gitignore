# Local documents, except the two reports this week's assignment asks to hand in.
# The Week 1 documents stay on disk but are no longer tracked here.
*.pdf
!/DesignReportWeek2.pdf
!/BenchmarkReportWeek2.pdf
/Assignment-week2.md

# Source datasets: downloaded, not authored here (~2.4 GB).
# Keep the empty folders so a fresh clone knows where the files go. Un-ignoring a
# directory re-includes its contents, so the contents are ignored again on the
# third line before .gitkeep is allowed back on the fourth.
/data/raw/*
!/data/raw/*/
/data/raw/*/*
!/data/raw/*/.gitkeep

# Derived output: rebuilt by `python jobs/run_ingest.py` (~727 MB).
# Delta transaction logs also record absolute paths, so a committed copy would
# not work on another machine.
/data/lakehouse/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Spark / Delta local artifacts
spark-warehouse/
metastore_db/
derby.log

# Working documents. README lists docs/common_data_model.md as the only one
# that ships; the rest are drafts behind the three PDFs.
/docs/*
!/docs/common_data_model.md
